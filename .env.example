# Database PostgreSQL (in locale: docker compose up -d postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/piattaforma
# Stringa casuale lunga: genera con `openssl rand -hex 32`
PAYLOAD_SECRET=
# URL pubblico del sito (vuoto in locale)
NEXT_PUBLIC_SERVER_URL=
# Accesso con Google @albertina.academy (vedi README, "Accesso con Google").
# Vuote = il pulsante non compare e resta solo email e password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File caricati su Google Drive (vedi README, "File su Google Drive"). Vuote = file sul disco.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# ID della cartella padre (Mio Drive di noreply@ o Drive condiviso)
DRIVE_ID=
# Account che collega Drive (predefinito: noreply@albertina.academy)
DRIVE_ACCOUNT=
# Cache su disco dei file letti da Drive (predefiniti: accanto a MEDIA_DIR, 2048 MB)
DRIVE_CACHE_DIR=
DRIVE_CACHE_MB=

# --- Solo per l'anteprima online (vedi README, "Anteprima online") ---
# Se impostata, tutto il sito chiede utente e password del browser e non viene indicizzato.
ANTEPRIMA_PASSWORD=
# Utente per l'anteprima (predefinito: albertina)
ANTEPRIMA_UTENTE=
# true = al primo avvio carica i contenuti demo se il database è vuoto
SEED_DEMO=
# Cartella dei file caricati su un volume persistente, es. /data/media
MEDIA_DIR=

# --- Email in uscita (TurboSMTP). Vuote = nessun invio. Ogni email (anche non spedita) finisce
# nel registro "Email inviate" del pannello, conservato 30 giorni ---
SMTP_HOST=
# 587 (STARTTLS) o 465 (SSL)
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Mittente, anche con nome: Accademia Albertina <noreply@albertina.academy>
EMAIL_MITTENTE=
# Se impostato, TUTTE le email vanno solo a questo indirizzo (prove in anteprima)
EMAIL_SOLO_A=

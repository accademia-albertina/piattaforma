{
  "name": "piattaforma",
  "version": "1.0.0",
  "description": "Piattaforma web dell’Accademia Albertina di Belle Arti di Torino",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config ./vitest.config.mts tests/unit",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "guida:schermate": "node scripts/guida/schermate.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^10.1.0",
    "date-fns": "4.1.0",
    "dotenv": "18.0.9",
    "graphql": "^16.8.1",
    "gsap": "3.15.0",
    "jose": "5.10.0",
    "lucide-react": "1.70.0",
    "next": "16.4.4",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-datepicker": "7.6.0",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "30.1.3",
    "prettier": "^3.4.2",
    "storybook": "10.6.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0",
      "dompurify": ">=3.4.16",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "happy-dom@>=17.0.0 <21.0.4": "21.0.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "private": true,
  "packageManager": "pnpm@10.28.0"
}
